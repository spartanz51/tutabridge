+	#[test]
+	fn audit_valid_aead_is_rejected_by_entity_field_decryption() {
+		use crypto_primitives::aead_facade::{AeadFacade, AeadSubKeys};
+		use crypto_primitives::versioned::Versioned;
+		let sk = Aes256Key::from_bytes(&KNOWN_SK).unwrap();
+		let generic_sk = GenericAesKey::Aes256(sk.clone());
+		let facade = AeadFacade::new(RandomizerFacade::from_core(rand_core::OsRng));
+		let model = create_model_value(ValueType::String, true, Cardinality::One);
+		let plaintext = b"synthetic audit field".to_vec();
+		let aad = b"audit associated data";
+		let subkeys = [
+			AeadSubKeys::derive_from_session_key(&sk, "tutanota/0"),
+			AeadSubKeys::derive_from_group_key(&Versioned::new(generic_sk.clone(), 0), &[7; 16], "tutanota/0"),
+		];
+		for subkey in subkeys {
+			let ciphertext = facade.encrypt(&subkey, plaintext.clone(), aad).unwrap();
+			assert_eq!(facade.decrypt(&subkey, &ciphertext, aad).unwrap(), plaintext);
+			let version = ciphertext[0];
+			let result = EntityFacadeImpl::decrypt_and_parse_value(
+				ElementValue::Bytes(ciphertext), &generic_sk, "audit", &model,
+			);
+			match result {
+				Err(error) => {
+					println!("Valid AEAD v{version}: primitive round-trip OK; entity decoder rejects it: {error}");
+					assert!(error.to_string().contains("MacError"));
+				},
+				Ok(_) => panic!("Expected current upstream entity decoder to reject AEAD"),
+			}
+		}
+	}
+
+	#[test]
+	fn audit_short_encrypted_field_reproduces_invalid_data_size() {
+		let sk = GenericAesKey::Aes256(Aes256Key::from_bytes(&KNOWN_SK).unwrap());
+		let model = create_model_value(ValueType::String, true, Cardinality::One);
+		match EntityFacadeImpl::decrypt_and_parse_value(ElementValue::Bytes(vec![1, 2, 3]), &sk, "audit", &model) {
+			Err(error) => {
+				println!("Synthetic short ciphertext: {error}");
+				assert!(error.to_string().contains("InvalidDataSizeError"));
+			},
+			Ok(_) => panic!("Expected invalid ciphertext length to fail"),
+		}
+	}
