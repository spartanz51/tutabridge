+	#[test]
+	fn audit_optional_empty_body_fields_reproduce_invalid_data_size() {
+		use crate::entities::generated::tutanota::Body;
+		let provider = Arc::new(TypeModelProvider::new_test(
+			Arc::new(MockRestClient::new()), Arc::new(MockFileClient::new()), "http://localhost:9000".into(),
+		));
+		let serializer = JsonSerializer::new(provider.clone());
+		let facade = EntityFacadeImpl::new(provider.clone(), RandomizerFacade::from_core(rand_core::OsRng));
+		let model = provider.resolve_server_type_ref(&Body::type_ref()).unwrap();
+		let sk = GenericAesKey::Aes256(Aes256Key::from_bytes(&KNOWN_SK).unwrap());
+		for (field, name) in [("1275", "Body.text"), ("1276", "Body.compressedText")] {
+			let mut raw: RawEntity = serde_json::from_str(r#"{"1274":"auditbody","1275":null,"1276":null}"#).unwrap();
+			let control = serializer.parse(&Body::type_ref(), raw.clone()).unwrap();
+			assert!(facade.decrypt_and_map_inner(&model, control, &sk).is_ok());
+			raw.insert(field.into(), JsonElement::String(String::new()));
+			let parsed = serializer.parse(&Body::type_ref(), raw).unwrap();
+			assert_eq!(parsed.get(field).unwrap(), &ElementValue::Bytes(vec![]));
+			match facade.decrypt_and_map_inner(&model, parsed, &sk) {
+				Err(error) => {
+					println!("{name} encoded as an empty string: {error}; null control succeeds");
+					assert!(error.to_string().contains("InvalidDataSizeError"));
+				},
+				Ok(_) => panic!("Expected current Rust decoder to reject the optional empty field"),
+			}
+		}
+	}
