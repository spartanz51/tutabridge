--- /dev/null
+++ b/tuta-sdk/rust/sdk/src/entities/entity_facade/field_path.rs
@@ -0,0 +1,63 @@
+use crate::metamodel::AttributeId;
+
+/// Path of an instance within the root entity's authenticated context.
+/// Extending a path leaves the parent unchanged for the next sibling.
+#[derive(Default)]
+pub(super) struct InstancePath(String);
+
+impl InstancePath {
+	pub(super) fn aggregate(&self, association_id: AttributeId, aggregate_id: &str) -> Self {
+		Self(format!(
+			"{}{}/{aggregate_id}/",
+			self.0,
+			String::from(association_id)
+		))
+	}
+
+	pub(super) fn value(&self, attribute_id: AttributeId) -> String {
+		format!("{}{}", self.0, String::from(attribute_id))
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+	use serde_json::Value;
+
+	#[test]
+	fn paths_match_upstream_typescript() {
+		let vectors: Vec<Value> = serde_json::from_str(include_str!(
+			"../../../tests/fixtures/crypto_dev_paths.json"
+		))
+		.unwrap();
+		for vector in vectors {
+			let mut path = InstancePath::default();
+			for segment in vector["segments"].as_array().unwrap() {
+				path = path.aggregate(
+					segment["association"].as_u64().unwrap().into(),
+					segment["aggregate"].as_str().unwrap(),
+				);
+			}
+			assert_eq!(
+				path.value(vector["attribute"].as_u64().unwrap().into()),
+				vector["path"].as_str().unwrap()
+			);
+		}
+	}
+
+	#[test]
+	fn extending_a_nested_path_does_not_change_its_parent_or_siblings() {
+		let root = InstancePath::default();
+		let parent = root.aggregate(3.into(), "first");
+		let first = parent.aggregate(9.into(), "child1");
+		let second = parent.aggregate(9.into(), "child2");
+		assert_eq!(first.value(17.into()), "3/first/9/child1/17");
+		assert_eq!(second.value(17.into()), "3/first/9/child2/17");
+		assert_eq!(parent.value(2.into()), "3/first/2");
+		assert_eq!(root.value(1.into()), "1");
+		assert_eq!(
+			root.aggregate(3.into(), "second").value(2.into()),
+			"3/second/2"
+		);
+	}
+}
