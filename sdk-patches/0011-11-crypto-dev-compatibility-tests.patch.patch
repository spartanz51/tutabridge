+	#[test]
+	fn crypto_dev_vectors_preserve_the_359_protocol_boundary() {
+		use super::super::decryption::InstanceDecryptor;
+		use std::collections::HashMap;
+		let vectors: Vec<Value> = serde_json::from_str(include_str!(
+			"../../../tests/fixtures/crypto_dev_attributes.json"
+		))
+		.unwrap();
+		for vector in vectors {
+			let key = GenericAesKey::from_bytes(
+				&BASE64_STANDARD
+					.decode(vector["key"].as_str().unwrap())
+					.unwrap(),
+			)
+			.unwrap();
+			let nonce = BASE64_STANDARD
+				.decode(vector["kdf_nonce"].as_str().unwrap())
+				.unwrap();
+			let ciphertext = BASE64_STANDARD
+				.decode(vector["ciphertext"].as_str().unwrap())
+				.unwrap();
+			let instance_type = vector["instance_type"].as_str().unwrap();
+			let path = vector["path"].as_str().unwrap();
+			let group_keys = HashMap::from([(7, key.clone())]);
+			let decryptor = InstanceDecryptor::with_group_keys(
+				Some(&key),
+				&group_keys,
+				Some(&nonce),
+				instance_type.into(),
+				RandomizerFacade::from_core(DeterministicRng(0x44)),
+			);
+			let input = if vector["version"] == 3 {
+				AeadEncryptionKey::SessionKey(key.clone())
+			} else {
+				AeadEncryptionKey::GroupKey(Versioned {
+					object: key.clone(),
+					version: 7,
+				})
+			};
+			let encryptor = InstanceEncryptor::new(
+				&input,
+				Some(&nonce),
+				instance_type,
+				RandomizerFacade::from_core(DeterministicRng(0x44)),
+			)
+			.unwrap();
+			let plaintext = vector["plaintext"].as_str().unwrap().as_bytes();
+			let written = encryptor.encrypt(plaintext.to_vec(), path).unwrap();
+			if vector["compatible_with_359"].as_bool().unwrap() {
+				assert_eq!(written, ciphertext);
+				assert_eq!(
+					decryptor.decrypt(&ciphertext, Some(path)).unwrap(),
+					plaintext
+				);
+			} else {
+				// crypto/dev retains the version bytes but changes the v2 derivation
+				// and the context of draft attributes. Do not guess another context.
+				assert_ne!(written, ciphertext);
+				assert!(decryptor
+					.decrypt(&ciphertext, Some(path))
+					.unwrap_err()
+					.to_string()
+					.contains("AEAD"));
+			}
+		}
+	}
+
